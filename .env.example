# Binance Web3 API (Developer Portal key with Trading, Market, Wallet, Transaction permissions)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Optional: JSONL telemetry for the DevEx log
DEVEX_EVENTS_PATH=devex/events.jsonl

# Checkout service
WALLET_MODE=api-signer
BUYER_PRIVATE_KEY=
BAW_BIN=baw
AW_PAYS_OWN_MERCHANT=true
MERCHANT_URL=http://localhost:9000
LIVE_PASSCODE=
LIVE_DAILY_MAX_COUNT=10
LIVE_DAILY_MAX_USD=1.50
RECEIPTS_SEED_PATH=data/receipts.seed.json
RECEIPTS_RUNTIME_PATH=data/runtime/receipts.json
WEB_DIST=packages/web/dist
PORT=8787

# Merchant agent (BNB Agent Studio). Wallet material lives in sharepaymerchant/.studio/ locally,
# or in WALLET_KEYSTORE_JSON + WALLET_PASSWORD on a host.
MERCHANT_PUBLIC_URL=http://localhost:9000
REPORT_PRICE_ATOMIC=50000000000000000
SWEEP_ENABLED=true
SWEEP_MIN_ATOMIC=50000000000000000
SWEEP_FLOAT_ATOMIC=0
SWEEP_MAX_ATOMIC=5000000000000000000
SWEEP_MAX_PRICE_IMPACT=2
SWEEP_SLIPPAGE=1
SWEEP_INTERVAL_MS=300000
ACTIVITY_PATH=data/runtime/merchant-activity.json
ACTIVITY_SEED_PATH=data/merchant-activity.seed.json

# Ops scripts (npm run smoke / npm run ops): the deployed checkout's public URL for the G5 smoke and the seed export
CHECKOUT_URL=http://localhost:8787
# The merchant's ERC-8004 agent id, printed by npx bag erc8004 register (G4 erc8004 smoke)
MERCHANT_AGENT_ID=
