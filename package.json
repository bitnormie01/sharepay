{
  "name": "sharepay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pay x402 bills with tokenized stocks on BSC; a BNB Agent Studio merchant self-settles and reinvests into SPYB.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json && vitest run",
    "check:web": "tsc -p packages/web/tsconfig.json && vitest run",
    "build:web": "vite build packages/web",
    "dev:web": "vite packages/web",
    "start:checkout": "tsx packages/checkout/src/main.ts",
    "start:checkout:local": "tsx --env-file-if-exists=.env packages/checkout/src/main.ts",
    "start:merchant": "npm run start --workspace sharepaymerchant-agent",
    "start:merchant:local": "npm run start:local --workspace sharepaymerchant-agent",
    "smoke": "tsx scripts/smoke.ts",
    "ops": "tsx scripts/ops.ts",
    "devex:summary": "tsx scripts/devex-summary.ts"
  },
  "devDependencies": {
    "@bnbagent/studio-cli": "0.0.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
